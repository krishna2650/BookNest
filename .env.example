# MongoDB Atlas Connection URL
ATLASDB_URL=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/?retryWrites=true&w=majority

# Cloudinary Credentials (Property Image Uploads)
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret

# Mapbox Token (Worldwide Destination Geocoding & Maps)
MAPBOX_TOKEN=pk.eyJ1IjoieW91ciIsImEiOiJ5b3VyX3Rva2VuIn0.xxxx

# Session Secret Key
SECRET=your_super_secret_session_key

# Razorpay Payment Gateway Credentials (Test Mode)
RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere
RAZORPAY_KEY_SECRET=yourRazorpayKeySecretHere
RAZORPAY_WEBHOOK_SECRET=yourRazorpayWebhookSecretHere

# Server Port (Optional, default 8080)
PORT=8080

