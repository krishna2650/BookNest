<% layout("/layouts/boilerplate") %>

<style>
    .chat-container {
        border-radius: 1rem;
        border: 1px solid #ebebeb;
        background: #ffffff;
        overflow: hidden;
    }
    .chat-messages {
        height: 450px;
        overflow-y: auto;
        padding: 1.5rem;
        background: #fbfbfb;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }
    .msg-bubble {
        max-width: 75%;
        padding: 0.75rem 1.25rem;
        border-radius: 1.25rem;
        font-size: 0.95rem;
        line-height: 1.4;
        position: relative;
    }
    .msg-outgoing {
        align-self: flex-end;
        background-color: #fe424d;
        color: #ffffff;
        border-bottom-right-radius: 0.25rem;
    }
    .msg-incoming {
        align-self: flex-start;
        background-color: #ffffff;
        color: #222222;
        border: 1px solid #ebebeb;
        border-bottom-left-radius: 0.25rem;
    }
    .msg-time {
        font-size: 0.7rem;
        margin-top: 0.25rem;
        opacity: 0.8;
    }
</style>

<div class="row mt-4 mb-5">
    <div class="col-lg-8 offset-lg-2">
        <div class="chat-container shadow-sm">
            <!-- Chat Header -->
            <div class="p-3 bg-white border-bottom d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <img src="<%= booking.listing && booking.listing.image ? booking.listing.image.url : '' %>" 
                         alt="<%= booking.listing ? booking.listing.title : '' %>" 
                         style="width: 50px; height: 50px; border-radius: 10px; object-fit: cover;" 
                         class="me-3">
                    <div>
                        <h6 class="fw-bold mb-0"><%= booking.listing ? booking.listing.title : 'Stay' %></h6>
                        <small class="text-muted">
                            Chatting with <strong>@<%= otherUser ? otherUser.username : 'User' %></strong> (<%= isGuest ? 'Host' : 'Guest' %>) &bull; Ref: <%= booking.bookingReference %>
                        </small>
                    </div>
                </div>
                <div>
                    <a href="/messages" class="btn btn-outline-secondary btn-sm" style="border-radius: 20px;">
                        <i class="fa-solid fa-arrow-left me-1"></i> Back
                    </a>
                </div>
            </div>

            <!-- Messages Stream -->
            <div class="chat-messages" id="messagesContainer">
                <% if (messages.length === 0) { %>
                    <div class="text-center my-auto text-muted small py-4">
                        <i class="fa-regular fa-comment-dots fs-3 mb-2 d-block"></i>
                        No messages exchanged yet. Send a greeting to start your conversation!
                    </div>
                <% } else { %>
                    <% for (let m of messages) { 
                         const isMe = m.sender._id.equals(currUser._id);
                    %>
                        <div class="msg-bubble <%= isMe ? 'msg-outgoing' : 'msg-incoming' %>">
                            <div><%= m.content %></div>
                            <div class="msg-time text-end <%= isMe ? 'text-white' : 'text-muted' %>">
                                <%= new Date(m.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %>
                            </div>
                        </div>
                    <% } %>
                <% } %>
            </div>

            <!-- Message Input Form -->
            <div class="p-3 bg-white border-top">
                <form action="/messages/<%= booking._id %>" method="POST" class="d-flex gap-2">
                    <input type="text" 
                           name="content" 
                           class="form-control" 
                           placeholder="Type your message..." 
                           required 
                           autocomplete="off"
                           style="border-radius: 25px; padding: 0.6rem 1.25rem;">
                    <button class="btn btn-danger add-btn px-4" type="submit" style="border-radius: 25px;">
                        <i class="fa-solid fa-paper-plane"></i>
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    // Auto-scroll to bottom of messages container
    (() => {
        const container = document.getElementById("messagesContainer");
        if (container) {
            container.scrollTop = container.scrollHeight;
        }
    })();
</script>

