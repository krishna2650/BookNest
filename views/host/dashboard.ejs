<% layout("/layouts/boilerplate") %>

<style>
    .stat-card {
        border-radius: 1rem;
        border: 1px solid #ebebeb;
        background-color: #ffffff;
        padding: 1.5rem;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .stat-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    }
    .property-thumb {
        width: 120px;
        height: 85px;
        border-radius: 0.75rem;
        object-fit: cover;
    }
    .nav-pills .nav-link.active {
        background-color: #fe424d !important;
        color: #fff !important;
    }
    .nav-pills .nav-link {
        color: #222;
        border-radius: 20px;
        padding: 0.5rem 1.25rem;
    }
</style>

<div class="row mt-4 mb-5">
    <div class="col-12">
        <!-- Dashboard Header -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
            <div>
                <h2 class="fw-bold mb-1">Host Dashboard</h2>
                <p class="text-muted mb-0">Welcome back, <strong><%= currUser.username %></strong> &bull; Manage your properties and guest reservations</p>
            </div>
            <div class="mt-3 mt-md-0">
                <a href="/listings/new" class="btn btn-danger add-btn px-4 py-2 fw-semibold" style="border-radius: 25px;">
                    <i class="fa-solid fa-plus me-1"></i> Add new property
                </a>
            </div>
        </div>

        <!-- Metric Cards -->
        <div class="row g-3 mb-4">
            <div class="col-sm-6 col-lg-3">
                <div class="stat-card">
                    <span class="text-muted small text-uppercase fw-semibold">Properties Listed</span>
                    <h3 class="fw-bold my-2 text-dark"><%= stats.totalProperties %></h3>
                    <small class="text-muted"><i class="fa-solid fa-house-chimney text-danger me-1"></i> Active listings</small>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="stat-card">
                    <span class="text-muted small text-uppercase fw-semibold">Upcoming / Active Stays</span>
                    <h3 class="fw-bold my-2 text-dark"><%= stats.upcomingCount %></h3>
                    <small class="text-success"><i class="fa-solid fa-calendar-check me-1"></i> <%= stats.currentCount %> currently staying</small>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="stat-card">
                    <span class="text-muted small text-uppercase fw-semibold">Completed Stays</span>
                    <h3 class="fw-bold my-2 text-dark"><%= stats.completedCount %></h3>
                    <small class="text-muted"><i class="fa-solid fa-circle-check text-primary me-1"></i> Successfully hosted</small>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="stat-card">
                    <span class="text-muted small text-uppercase fw-semibold">Total Revenue</span>
                    <h3 class="fw-bold my-2 text-danger">&#8377; <%= stats.totalEarnings.toLocaleString("en-IN") %></h3>
                    <small class="text-muted"><i class="fa-solid fa-indian-rupee-sign text-success me-1"></i> Gross booking value</small>
                </div>
            </div>
        </div>

        <!-- Navigation Tabs: Reservations vs My Properties -->
        <ul class="nav nav-pills mb-4" id="hostTab" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="reservations-tab" data-bs-toggle="pill" data-bs-target="#reservations" type="button" role="tab">
                    <i class="fa-solid fa-clipboard-list me-1"></i> Guest Reservations (<%= allBookings.length %>)
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="properties-tab" data-bs-toggle="pill" data-bs-target="#properties" type="button" role="tab">
                    <i class="fa-solid fa-building me-1"></i> My Properties (<%= listings.length %>)
                </button>
            </li>
        </ul>

        <div class="tab-content" id="hostTabContent">
            <!-- TAB 1: GUEST RESERVATIONS -->
            <div class="tab-pane fade show active" id="reservations" role="tabpanel">
                <% if (allBookings.length === 0) { %>
                    <div class="text-center py-5 border rounded bg-light">
                        <i class="fa-solid fa-inbox mb-3" style="font-size: 3rem; color: #fe424d;"></i>
                        <h5>No reservations received yet</h5>
                        <p class="text-muted">When travelers book your properties, their details and dates will appear here.</p>
                        <a href="/listings/new" class="btn btn-outline-danger btn-sm" style="border-radius: 20px;">
                            List another property
                        </a>
                    </div>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle border bg-white rounded shadow-sm">
                            <thead class="table-light">
                                <tr>
                                    <th>Property</th>
                                    <th>Guest Info</th>
                                    <th>Check-in &ndash; Check-out</th>
                                    <th>Guests & Nights</th>
                                    <th>Total Payout</th>
                                    <th>Status</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% for (let b of allBookings) { %>
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <img src="<%= b.listing && b.listing.image ? b.listing.image.url : '' %>" 
                                                     alt="<%= b.listing ? b.listing.title : '' %>" 
                                                     style="width: 50px; height: 50px; border-radius: 8px; object-fit: cover;" 
                                                     class="me-2">
                                                <div>
                                                    <a href="/listings/<%= b.listing ? b.listing._id : '' %>" class="fw-bold text-decoration-none text-dark">
                                                        <%= b.listing ? b.listing.title : 'Property' %>
                                                    </a>
                                                    <div class="text-muted small">Ref: <%= b.bookingReference %></div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="fw-semibold">@<%= b.user ? b.user.username : 'Guest' %></div>
                                            <div class="text-muted small"><%= b.user ? b.user.email : '' %></div>
                                        </td>
                                        <td>
                                            <div><strong><%= new Date(b.checkIn).toLocaleDateString("en-IN", { month: 'short', day: 'numeric', year: 'numeric' }) %></strong></div>
                                            <div class="text-muted small">to <%= new Date(b.checkOut).toLocaleDateString("en-IN", { month: 'short', day: 'numeric', year: 'numeric' }) %></div>
                                        </td>
                                        <td>
                                            <div><%= b.nights %> <%= b.nights === 1 ? 'night' : 'nights' %></div>
                                            <div class="text-muted small"><%= b.guests %> <%= b.guests === 1 ? 'guest' : 'guests' %></div>
                                        </td>
                                        <td>
                                            <div class="fw-bold text-danger">&#8377; <%= b.totalPrice.toLocaleString("en-IN") %></div>
                                            <div class="text-muted small">Payment: <%= b.paymentStatus %></div>
                                        </td>
                                        <td>
                                            <span class="badge <%= b.status === 'confirmed' ? 'bg-success' : 'bg-secondary' %> text-uppercase">
                                                <%= b.status %>
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <div class="d-flex justify-content-end gap-1">
                                                <a href="/messages/<%= b._id %>" class="btn btn-outline-secondary btn-sm" title="Message Guest" style="border-radius: 15px;">
                                                    <i class="fa-regular fa-comment-dots"></i>
                                                </a>
                                                <a href="/listings/<%= b.listing ? b.listing._id : '' %>" class="btn btn-outline-dark btn-sm" title="View Property" style="border-radius: 15px;">
                                                    <i class="fa-solid fa-eye"></i>
                                                </a>
                                                <% if (b.status === 'confirmed') { %>
                                                    <form action="/host/bookings/<%= b._id %>/cancel" method="POST" onsubmit="return confirm('Are you sure you want to cancel this reservation and reopen these dates for other guests?');" style="display: inline;">
                                                        <button class="btn btn-outline-danger btn-sm" title="Cancel Reservation" style="border-radius: 15px;">
                                                            <i class="fa-solid fa-xmark"></i>
                                                        </button>
                                                    </form>
                                                <% } %>
                                            </div>
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>

            <!-- TAB 2: MY PROPERTIES -->
            <div class="tab-pane fade" id="properties" role="tabpanel">
                <% if (listings.length === 0) { %>
                    <div class="text-center py-5 border rounded bg-light">
                        <i class="fa-solid fa-house-chimney-medical mb-3" style="font-size: 3rem; color: #fe424d;"></i>
                        <h5>You haven't listed any properties yet</h5>
                        <p class="text-muted">Start hosting by adding your first home, apartment, or villa to BookNest.</p>
                        <a href="/listings/new" class="btn btn-danger add-btn px-4 py-2" style="border-radius: 25px;">
                            Add your first property
                        </a>
                    </div>
                <% } else { %>
                    <div class="row g-4">
                        <% for (let listing of listings) { %>
                            <div class="col-md-6 col-lg-4">
                                <div class="card h-100 shadow-sm border-0" style="border-radius: 1rem; overflow: hidden;">
                                    <img src="<%= listing.image ? listing.image.url : '' %>" 
                                         alt="<%= listing.title %>" 
                                         style="height: 180px; object-fit: cover;" 
                                         class="w-100">
                                    <div class="card-body p-3 d-flex flex-column justify-content-between">
                                        <div>
                                            <h5 class="fw-bold mb-1 text-truncate"><%= listing.title %></h5>
                                            <p class="text-muted small mb-2">
                                                <i class="fa-solid fa-location-dot text-danger me-1"></i>
                                                <%= listing.location %>, <%= listing.country %>
                                            </p>
                                            <p class="fw-semibold mb-3">
                                                &#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : 0 %> <span class="text-muted fw-normal small">/ night</span>
                                            </p>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                            <a href="/listings/<%= listing._id %>" class="btn btn-outline-dark btn-sm" style="border-radius: 15px;">
                                                View
                                            </a>
                                            <div class="d-flex gap-1">
                                                <a href="/listings/<%= listing._id %>/edit" class="btn btn-outline-secondary btn-sm" style="border-radius: 15px;">
                                                    Edit
                                                </a>
                                                <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" onsubmit="return confirm('Are you sure you want to delete this listing?');" style="display: inline;">
                                                    <button class="btn btn-outline-danger btn-sm" style="border-radius: 15px;">
                                                        Delete
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% } %>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</div>

