<!-- Razorpay Simulated Test Modal for Sample/Demo Web Experience -->
<div class="modal fade" id="razorpaySimModal" tabindex="-1" aria-labelledby="razorpaySimModalLabel" aria-hidden="true" data-bs-backdrop="static">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg" style="border-radius: 16px; overflow: hidden; position: relative;">
      
      <!-- Slanted Test Mode Ribbon -->
      <div style="position: absolute; top: 16px; right: -32px; background: #e11d48; color: #fff; font-size: 0.72rem; font-weight: 700; padding: 3px 36px; transform: rotate(45deg); z-index: 1055; box-shadow: 0 2px 6px rgba(0,0,0,0.25); letter-spacing: 0.5px; pointer-events: none;">
        TEST MODE
      </div>

      <!-- Razorpay Header -->
      <div class="p-3 text-white" style="background: linear-gradient(135deg, #072654, #0c3875);">
        <div class="d-flex justify-content-between align-items-center mb-2 pe-4">
          <div class="d-flex align-items-center">
            <span class="fw-bold fs-5 tracking-tight me-2">BookNest</span>
            <span class="badge bg-primary-subtle text-white px-2 py-1" style="font-size: 0.7rem; background-color: rgba(255,255,255,0.2) !important;">Test Gateway</span>
          </div>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" id="rzpSimCloseBtn"></button>
        </div>
        <div class="d-flex justify-content-between align-items-baseline">
          <div>
            <small class="text-white-50 d-block text-truncate" id="rzpModalPropTitle" style="max-width: 220px;">Property Reservation</small>
            <small class="text-white-50" id="rzpModalRef">Ref: BN-XXXXXX</small>
          </div>
          <div class="text-end pe-4">
            <small class="text-white-50 d-block">Amount</small>
            <span class="fs-4 fw-bold text-white" id="rzpModalAmount">&#8377; 0</span>
          </div>
        </div>
      </div>

      <!-- Modal Body -->
      <div class="modal-body p-4 bg-light">
        <!-- Sample Mode Banner -->
        <div class="alert alert-info py-2 px-3 small mb-3 d-flex align-items-center" style="border-radius: 10px; font-size: 0.82rem;">
          <i class="fa-solid fa-circle-info me-2 fs-6 text-primary"></i>
          <div>
            <strong>Sample Website Mode:</strong> No real payment is required. You can test the complete payment confirmation lifecycle safely.
          </div>
        </div>

        <!-- Payment Method Tabs -->
        <ul class="nav nav-pills nav-fill mb-3 bg-white p-1 rounded-pill border" id="pills-rzp-tab" role="tablist">
          <li class="nav-item" role="presentation">
            <button class="nav-link active rounded-pill py-2 small fw-semibold" id="pills-card-tab" data-bs-toggle="pill" data-bs-target="#pills-card" type="button" role="tab">
              <i class="fa-regular fa-credit-card me-1"></i> Card
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill py-2 small fw-semibold" id="pills-upi-tab" data-bs-toggle="pill" data-bs-target="#pills-upi" type="button" role="tab">
              <i class="fa-solid fa-mobile-screen-button me-1"></i> UPI
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link rounded-pill py-2 small fw-semibold" id="pills-nb-tab" data-bs-toggle="pill" data-bs-target="#pills-nb" type="button" role="tab">
              <i class="fa-solid fa-building-columns me-1"></i> NetBanking
            </button>
          </li>
        </ul>

        <div class="tab-content bg-white p-3 rounded-3 border" id="pills-rzp-tabContent">
          <!-- CARD TAB -->
          <div class="tab-pane fade show active" id="pills-card" role="tabpanel">
            <div class="mb-2">
              <label class="form-label small text-muted mb-1">Card Number (Sample Test Card)</label>
              <div class="input-group input-group-sm">
                <span class="input-group-text bg-light"><i class="fa-brands fa-cc-visa text-primary fs-5"></i></span>
                <input type="text" class="form-control" value="4111 1111 1111 1111" readonly>
              </div>
            </div>
            <div class="row g-2 mb-2">
              <div class="col-6">
                <label class="form-label small text-muted mb-1">Valid Thru</label>
                <input type="text" class="form-control form-control-sm" value="12 / 28" readonly>
              </div>
              <div class="col-6">
                <label class="form-label small text-muted mb-1">CVV</label>
                <input type="password" class="form-control form-control-sm" value="123" readonly>
              </div>
            </div>
            <small class="text-success" style="font-size: 0.75rem;"><i class="fa-solid fa-circle-check me-1"></i> Test credentials pre-verified</small>
          </div>

          <!-- UPI TAB -->
          <div class="tab-pane fade" id="pills-upi" role="tabpanel">
            <div class="d-flex justify-content-around py-2">
              <div class="text-center">
                <span class="badge bg-light text-dark border p-2 mb-1 d-block"><i class="fa-brands fa-google-pay fs-3 text-primary"></i></span>
                <small class="d-block text-muted" style="font-size: 0.72rem;">Google Pay</small>
              </div>
              <div class="text-center">
                <span class="badge bg-light text-dark border p-2 mb-1 d-block"><i class="fa-solid fa-wallet fs-3" style="color: #6739b7;"></i></span>
                <small class="d-block text-muted" style="font-size: 0.72rem;">PhonePe</small>
              </div>
              <div class="text-center">
                <span class="badge bg-light text-dark border p-2 mb-1 d-block"><i class="fa-solid fa-qrcode fs-3 text-dark"></i></span>
                <small class="d-block text-muted" style="font-size: 0.72rem;">Any UPI QR</small>
              </div>
            </div>
            <input type="text" class="form-control form-control-sm mt-2" value="guest@upi (Demo Test UPI)" readonly>
          </div>

          <!-- NETBANKING TAB -->
          <div class="tab-pane fade" id="pills-nb" role="tabpanel">
            <div class="d-flex flex-wrap gap-2 py-2">
              <span class="badge bg-light text-dark border p-2"><i class="fa-solid fa-building me-1"></i> HDFC Bank</span>
              <span class="badge bg-light text-dark border p-2"><i class="fa-solid fa-building me-1"></i> SBI</span>
              <span class="badge bg-light text-dark border p-2"><i class="fa-solid fa-building me-1"></i> ICICI Bank</span>
              <span class="badge bg-light text-dark border p-2"><i class="fa-solid fa-building me-1"></i> Axis Bank</span>
            </div>
            <small class="text-muted d-block" style="font-size: 0.75rem;">Simulated retail net banking sandbox</small>
          </div>
        </div>

        <div id="rzpSimAlert" class="alert alert-danger py-2 small mt-3" style="display: none;"></div>

        <!-- Pay Button -->
        <button id="rzpSimPayBtn" class="btn btn-primary w-100 py-2 mt-3 fw-bold shadow-sm" style="background: #0284c7; border: none; border-radius: 25px;">
          <i class="fa-solid fa-lock me-1"></i> Pay Now (Instant Confirmation)
        </button>

        <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
          <button type="button" class="btn btn-link btn-sm text-danger text-decoration-none p-0" id="rzpSimFailBtn" style="font-size: 0.78rem;">
            Simulate Payment Failure
          </button>
          <div class="text-muted" style="font-size: 0.75rem;">
            Secured by <strong style="color: #0c2340;"><i class="fa-solid fa-bolt text-primary me-1"></i>Razorpay</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

